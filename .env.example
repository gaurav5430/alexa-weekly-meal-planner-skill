# Google Sheet ID (from the URL)
# Example: https://docs.google.com/spreadsheets/d/ABC123.../edit
# Use: ABC123...
GOOGLE_SHEET_ID=your_sheet_id_here

# Path to Google service account credentials JSON file
# Download from Google Cloud Console -> Service Accounts
CREDENTIALS_PATH=credentials.json

# ===== Testing Configuration =====

# Enable real Google Sheets API testing (for E2E tests)
# Set to 'true' to test with actual Google Sheets instead of mocked data
# Requires valid credentials.json and GOOGLE_SHEET_ID
USE_REAL_SHEETS_API=false
